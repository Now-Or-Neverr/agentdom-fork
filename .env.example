# Agentdom configuration. Copy to .env and fill in what you use.
# Never commit the real .env file.

# ---------- Core ----------
PORT=8790
PUBLIC_URL=http://localhost:5173
# Proxy hops to trust for client IPs (e.g. "loopback", or 1 behind one reverse proxy)
TRUST_PROXY=loopback
# Also trust Cloudflare's published IP ranges when TRUST_PROXY is a hop count (1 = on)
TRUST_CLOUDFLARE=
# Admin key for /admin pages (16+ chars). If empty, one is generated in data/admin-key.txt
ADMIN_KEY=

# ---------- Claude (required for agents) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_LESSONS_MODEL=claude-haiku-5-5
WORKER_CONCURRENCY=2
DECREE_MAX_TOOL_CALLS=16
DECREE_INPUT_TOKEN_BUDGET=250000

# ---------- App Builder and designed images (OpenRouter) ----------
# Powers /build (describe an app, get a link) and the Atelier's designed images
OPENROUTER_API_KEY=
BUILDER_MODEL=anthropic/claude-sonnet-5.5
BUILDER_MAX_TOKENS=32000
# Reasoning effort for the builder model: low (fast, default), medium or high
BUILDER_REASONING_EFFORT=low
BUILDER_DAILY_USD=1.5
BUILDER_PER_USER=3
BUILDER_REVISIONS_PER_USER=6
BUILDER_GLOBAL=40
BUILDER_COOLDOWN_S=60
BUILDER_MAX_CONCURRENT=6
# Daily builder caps apply from this moment (ISO date)
BUILDER_LIMITS_FROM=
# Reports needed to hide a public build pending review
BUILDER_REPORT_HIDE=5
OR_IMAGE_MODEL=google/gemini-3.1-flash-image
OR_IMAGE_DAILY=25

# ---------- Bot protection (Cloudflare Turnstile, optional) ----------
# Protected POSTs require a Turnstile token only when both keys are set
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Limits that protect the API budget ----------
DAILY_DECREES_PER_USER=5
DAILY_DECREES_PER_IP=10
DAILY_DECREES_GLOBAL=200
SCHEDULED_DECREES_PER_DAY=
VIZIER_PLANS_PER_DAY=
WORKSHOP_IMAGES_PER_USER=
WORKSHOP_IMAGES_GLOBAL=
# Follow-up questions on delivered decrees
FOLLOWUPS_PER_DECREE=10
FOLLOWUPS_PER_USER=20
FOLLOWUPS_GLOBAL=300
# Simulated in-app currency. Off by default: everything is free and crown amounts are hidden
CROWNS_ENABLED=

# ---------- Royal duties (automatic work with free public APIs) ----------
# Set to "off" to stop automatic duties
DUTIES=
DUTIES_PER_HOUR=60
DUTY_INTERVAL_MS=50000
DUTY_POSTER_HOURS=
REALM_LAT=
REALM_LON=

# ---------- Research and data ----------
TAVILY_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
FIRECRAWL_API_KEY=
GNEWS_API_KEY=
YOUTUBE_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
WOLFRAM_APP_ID=
COURTLISTENER_TOKEN=
GEOAPIFY_API_KEY=
PAGESPEED_API_KEY=
# Raises the OpenAlex daily budget (works without a key)
OPENALEX_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
COMPANIES_HOUSE_API_KEY=
USDA_API_KEY=
URLSCAN_API_KEY=
BRANDFETCH_API_KEY=
# Lifetime cap on real Brandfetch requests
BRANDFETCH_MAX_CALLS=90

# ---------- Media ----------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_NEURON_BUDGET=
PIXABAY_API_KEY=
FREESOUND_CLIENT_ID=
FREESOUND_API_KEY=
REMOVEBG_API_KEY=
REMOVEBG_MONTHLY=
REMOVEBG_PER_USER_DAY=
POLLINATIONS_TOKEN=
HF_TOKEN=
HF_CAPTION_MODEL=
# Speech to text (Whisper) and OCR
GROQ_API_KEY=
OCRSPACE_API_KEY=
# Recorded voice-overs
ELEVENLABS_API_KEY=
ELEVENLABS_MONTHLY_CREDITS=9000

# ---------- Publishing (GitHub Pages for Forge websites) ----------
GITHUB_TOKEN=
GITHUB_PAGES_REPO=owner/repo
# Live publishing is off unless set to 1 (otherwise a dry run is returned)
PUBLISH_ENABLED=

# ---------- Notifications and Heralds ----------
# Telegram / Discord messages are sent only when NOTIFY_ENABLED=1
NOTIFY_ENABLED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# Bluesky posts are drafted by agents and published only after admin approval
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social

# Newer guilds (all free). Observatory: NASA (api.nasa.gov), OpenAQ air quality (v3).
NASA_API_KEY=
OPENAQ_API_KEY=
# Arena: football-data.org, TMDB (credit "Data: TMDB"), Last.fm.
FOOTBALL_DATA_TOKEN=
TMDB_API_KEY=
TMDB_READ_TOKEN=
LASTFM_API_KEY=
# Atelier: Unsplash (credit the photographer). News: The Guardian and New York Times (headline, excerpt and link only).
UNSPLASH_ACCESS_KEY=
GUARDIAN_API_KEY=
NYT_API_KEY=

# X (OAuth 2.0 app, type "Web App", Read and write). Connect from /admin/herald.
# Only X_HANDLE can be connected; any other account is refused. X_AUTOPOST=1 lets admin drafts
# with a scheduled time post by themselves (agent drafts never go to X). Off by default.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://your-domain/api/admin/x/callback
X_HANDLE=agentdomworld
X_AUTOPOST=0
X_DAILY_LIMIT=5

# $AGENTDOM holder perks (wallet linked by a free signature, balance read from Robinhood Chain)
HOLDER_MIN_TOKENS=1000000
HOLDER_BONUS_DECREES=5
# Optional: a Robinhood Chain RPC with a key (e.g. Alchemy) if the public RPC rate-limits
ROBINHOOD_RPC_URL=
# Robinhood Chain data providers (optional, free tiers)
ALCHEMY_API_KEY=
BLOCKSCOUT_API_KEY=
CHAINSTACK_RPC_URL=
COINGECKO_API_KEY=
# More Robinhood Chain sources (optional): Codex charts and launches, Zerion portfolios, Goldsky backup RPC,
# GoPlus keyed limits, Chainlink Candlestick share candles
CODEX_API_KEY=
ZERION_API_KEY=
GOLDSKY_API_KEY=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
CHAINLINK_CANDLESTICK_USER=
CHAINLINK_CANDLESTICK_API_KEY=
