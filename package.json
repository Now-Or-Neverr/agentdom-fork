{
  "name": "agentdom",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A kingdom of AI agents that do real work.",
  "homepage": "https://agentdom.world",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentdomworld/agentdom.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@solana/web3.js": "^3.2.1",
    "bs58": "^6.0.0",
    "compression": "^1.8.1",
    "docx": "9.5.1",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.460.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.0",
    "three": "^0.170.0",
    "tweetnacl": "^1.0.3",
    "viem": "2.57.11"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
